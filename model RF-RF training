# ================================================================

rng = np.random.default_rng(
    RANDOM_STATE
)

bootstrap_metrics = {

    metric: []

    for metric in final_metrics.keys()

    if metric not in [
        "TN",
        "FP",
        "FN",
        "TP"
    ]
}


n_patients = len(
    final_y
)


for bootstrap_number in range(
    N_BOOTSTRAP
):
    
    bootstrap_idx = rng.choice(

        np.arange(
            n_patients
        ),

        size=n_patients,

        replace=True
    )


    y_boot = final_y[
        bootstrap_idx
    ]

    prob_boot = final_prob[
        bootstrap_idx
    ]


    # AUC needs both classes
    if len(
        np.unique(
            y_boot
        )
    ) < 2:

        continue
        

    metrics_boot = calculate_metrics(

        y_boot,

        prob_boot,

        threshold=CLASSIFICATION_THRESHOLD
    )


    for metric in bootstrap_metrics:

        bootstrap_metrics[
            metric
        ].append(

            metrics_boot[
                metric
            ]
        )
# ------------------------------------------------
# CI table
# ------------------------------------------------

performance_rows = []


for metric, estimate in final_metrics.items():

    if metric in [
        "TN",
        "FP",
        "FN",
        "TP"
    ]:

        continue


    values = np.asarray(
        bootstrap_metrics[
            metric
        ]
    )


    performance_rows.append({

        "Metric":
            metric,

        "Estimate":
            estimate,

        "95% CI Lower":
            np.percentile(
                values,
                2.5
            ),

        "95% CI Upper":
            np.percentile(
                values,
                97.5
            )
    })


performance_ci_df = pd.DataFrame(
