# ================================================================
# 6. CORRELATION FILTER
# ================================================================
#
# This transformer is INSIDE the sklearn Pipeline.
#
# Therefore:
# - constant-feature removal
# - Spearman correlation calculation
# - correlated-feature removal
#
# are fitted only on the corresponding training fold.
#
# ================================================================

class CorrelationFilter(
    BaseEstimator,
    TransformerMixin
):

    def __init__(
        self,
        threshold=0.90,
        method="spearman"
    ):

        self.threshold = threshold
        self.method = method


    def fit(
        self,
        X,
        y=None
    ):

        if not isinstance(
            X,
            pd.DataFrame
        ):

            X = pd.DataFrame(X)


        self.feature_names_in_ = np.asarray(
            X.columns
        )


        # --------------------------------------------------------
        # Remove constant features
        # --------------------------------------------------------

        nunique = X.nunique(
            dropna=False
        )


        self.constant_features_ = list(

            nunique[
                nunique <= 1
            ].index
        )


        X_temp = X.drop(

            columns=
                self.constant_features_,

            errors=
                "ignore"
        )


        # --------------------------------------------------------
        # Absolute Spearman correlation
        # --------------------------------------------------------

        corr = X_temp.corr(
            method=self.method
        ).abs()


        upper = corr.where(

            np.triu(

                np.ones(
                    corr.shape
                ),

                k=1

            ).astype(bool)
        )


        self.correlated_features_ = [

            column

            for column
            in upper.columns

            if (

                upper[column]
                >
                self.threshold

            ).any()
        ]


        self.features_to_keep_ = [

            column

            for column
            in X_temp.columns

            if column
            not in self.correlated_features_
        ]


        return self


    def transform(
        self,
        X
    ):

        if not isinstance(
            X,
            pd.DataFrame
        ):

            X = pd.DataFrame(

                X,

                columns=
                    self.feature_names_in_
            )


        return X[
            self.features_to_keep_
        ].copy()


    def get_feature_names_out(
        self,
        input_features=None
    ):

        return np.asarray(
            self.features_to_keep_
        )


