)


# ================================================================
# STORAGE
# ================================================================

outer_results = []

k_search_results = []

test_prediction_records = []

selected_feature_records = []

chosen_parameter_records = []


# ================================================================
# 10. MAIN ANALYSIS
# ================================================================

for outer_number, (
    train_idx,
    test_idx
) in enumerate(

    outer_splitter.split(
        X,
        y
    ),

    start=1
):


    print(
        "\n========================================"
    )


    print(
        f"Outer repetition "
        f"{outer_number}/"
        f"{N_OUTER_SPLITS}"
    )


    print(
        "========================================"
    )


    X_train = X.iloc[
        train_idx
    ].copy()


    X_test = X.iloc[
        test_idx
    ].copy()


    y_train = y.iloc[
        train_idx
    ].copy()


    y_test = y.iloc[
        test_idx
    ].copy()


    # ============================================================
    # INNER STRATIFIED 5-FOLD CV
    # ============================================================

    inner_cv = StratifiedKFold(

        n_splits=
            INNER_FOLDS,

        shuffle=
            True,

        random_state=
            RANDOM_STATE
            +
            outer_number
    )


    # ============================================================
    # CACHE
    # ============================================================

    split_cache = os.path.join(

        CACHE_ROOT,

        f"outer_{outer_number}"
    )


    memory = Memory(

        location=
            split_cache,

        verbose=
            0
    )


    # ============================================================
    # BEST MODEL IN THIS REPETITION
    # ============================================================

    best_inner_auc = -np.inf

    selected_k = None

    selected_grid = None


    # ============================================================
    # FEATURE COUNT LOOP: 3 -> 10
    # ============================================================

    for num_features in FEATURE_COUNTS:


        # ========================================================
        # PIPELINE
        #
        # Spearman correlation filtering
        #        ↓
        # StandardScaler
        #        ↓
        # XGBoost feature selector
        #        ↓
        # Logistic Regression classifier
        #
        # ========================================================

        pipeline = Pipeline(

            steps=[


                # ------------------------------------------------
                # CORRELATION FILTER
                # ------------------------------------------------

                (
                    "corr_filter",

                    CorrelationFilter(

                        threshold=
                            CORRELATION_THRESHOLD,

                        method=
                            "spearman"
                    )
                ),


                # ------------------------------------------------
                # STANDARDIZATION
                #
                # XGBoost itself does not require scaling,
                # but LR classifier does.
                #
                # Keeping scaler before the selector ensures that
                # the selected variables passed to LR are already
                # standardized.
                # ------------------------------------------------

                (
                    "scaler",

                    StandardScaler()
                ),


                # ------------------------------------------------
                # FEATURE SELECTOR =
                # XGBOOST
                # ------------------------------------------------

                (
                    "selector",

                    SelectFromModel(

                        estimator=
                            XGBClassifier(

                                objective=
                                    "binary:logistic",

                                n_estimators=
                                    XGB_SELECTOR_N_ESTIMATORS,

                                max_depth=
                                    XGB_SELECTOR_MAX_DEPTH,

                                learning_rate=
                                    XGB_SELECTOR_LEARNING_RATE,

                                subsample=
                                    XGB_SELECTOR_SUBSAMPLE,

                                colsample_bytree=
                                    XGB_SELECTOR_COLSAMPLE_BYTREE,

                                reg_alpha=
                                    XGB_SELECTOR_REG_ALPHA,

                                reg_lambda=
                                    XGB_SELECTOR_REG_LAMBDA,

                                importance_type=
                                    XGB_SELECTOR_IMPORTANCE_TYPE,

                                eval_metric=
                                    "logloss",

                                tree_method=
                                    "hist",

                                random_state=
                                    RANDOM_STATE,

                                n_jobs=
                                    1
                            ),

                        threshold=
                            -np.inf,

                        max_features=
                            num_features
                    )
                ),


                # ------------------------------------------------
                # CLASSIFIER =
                # LOGISTIC REGRESSION
                # ------------------------------------------------

                (
                    "classifier",

                    LogisticRegression(

                        solver=
                            "liblinear",

                        max_iter=
                            5000,

                        random_state=
                            RANDOM_STATE
                    )
                )
            ],

            memory=
                memory
        )


        # ========================================================
        # GRID SEARCH
        # ========================================================

        grid_search = GridSearchCV(

            estimator=
                pipeline,

            param_grid=
                param_grid,

            cv=
                inner_cv,

            scoring=
                "roc_auc",

            n_jobs=
                -1,

            refit=
                True,

            return_train_score=
                False,

            error_score=
                "raise",

            verbose=
                0
        )


        # ========================================================
        # FIT
        #
        # Correlation filtering,
        # scaling,
        # XGBoost feature selection,
        # and LR hyperparameter optimization
        #
        # are all conducted within internal CV.
        # ========================================================

        grid_search.fit(

            X_train,

            y_train
        )


        current_inner_auc = (
            grid_search
            .best_score_
        )


        best_params_k = (
            grid_search
            .best_params_
        )


        # ========================================================
        # RECORD RESULT FOR THIS k
        # ========================================================

        k_record = {

            "Outer_Repetition":
                outer_number,

            "Num_Features":
                num_features,

            "Best_Inner_CV_AUC":
                current_inner_auc,

            "Best_C":
                best_params_k[
                    "classifier__C"
                ],

            "Best_penalty":
                best_params_k[
                    "classifier__penalty"
                ],

            "Best_class_weight":
                str(
                    best_params_k[
                        "classifier__class_weight"
                    ]
                )
        }


        k_search_results.append(
            k_record
        )


        print(

            f"k={num_features}: "

            f"best inner AUC="
            f"{current_inner_auc:.3f} | "

            f"C="
            f"{best_params_k['classifier__C']} | "

            f"penalty="
            f"{best_params_k['classifier__penalty']} | "

            f"class_weight="
            f"{best_params_k['classifier__class_weight']}"
        )


        # ========================================================
        # SELECT BEST k USING ONLY INNER CV
        #
        # Exact tie -> smaller k wins
        # ========================================================

        if (

            current_inner_auc
            >
            best_inner_auc
            +
            1e-12

        ):

            best_inner_auc = (
                current_inner_auc
            )

            selected_k = (
                num_features
            )

            selected_grid = (
                grid_search
            )


    # ============================================================
    # 11. BEST PIPELINE REFITTED ON COMPLETE 85% TRAINING SET
    # ============================================================
    #
    # Because GridSearchCV uses refit=True,
    # selected_grid.best_estimator_ is already refitted
    # on the complete outer training set using:
    #
    # - selected feature count
    # - selected features
    # - optimal LR hyperparameters
    #
    # ============================================================

    best_model = (
        selected_grid
        .best_estimator_
    )


    # ============================================================
    # HELD-OUT TEST PREDICTIONS
    # ============================================================

    y_test_prob = (

        best_model

        .predict_proba(
            X_test
        )[:, 1]
    )


    y_test_pred = (

        y_test_prob

        >=
        CLASSIFICATION_THRESHOLD

    ).astype(int)


    test_metrics = calculate_metrics(

        y_test,

        y_test_prob,

        threshold=
            CLASSIFICATION_THRESHOLD
    )


    # ============================================================
    # CORRELATION FILTER INFORMATION
    # ============================================================

    fitted_corr_filter = (

        best_model

        .named_steps[
            "corr_filter"
        ]
    )


    corr_feature_names = (

        fitted_corr_filter

        .get_feature_names_out()
    )


    n_after_correlation = len(
        corr_feature_names
    )


    # ============================================================
    # SELECTED FEATURES
    # ============================================================

    fitted_selector = (

        best_model

        .named_steps[
            "selector"
        ]
    )


    selected_mask = (

        fitted_selector

        .get_support()
    )


    selected_feature_names = (

        corr_feature_names[
            selected_mask
        ]
    )


    # ------------------------------------------------------------
    # XGBoost gain importance
    # ------------------------------------------------------------

    selector_importance = (

        fitted_selector

        .estimator_

        .feature_importances_
    )


    selected_importance = (

        selector_importance[
            selected_mask
        ]
    )


    # ============================================================
    # STORE SELECTED FEATURES
    # ============================================================

    for feature_name, importance in zip(

        selected_feature_names,

        selected_importance
    ):

        selected_feature_records.append({

            "Outer_Repetition":
                outer_number,

            "Selected_K":
                selected_k,

            "Feature":
                feature_name,

            "Selector_XGB_Gain_Importance":
                importance
        })


    # ============================================================
    # STORE CHOSEN LR PARAMETERS
    # ============================================================

    best_params = (
        selected_grid
        .best_params_
    )


    chosen_parameter_records.append({

        "Outer_Repetition":
            outer_number,

        "Selected_K":
            selected_k,

        "Best_Inner_CV_AUC":
            best_inner_auc,

        "C":
            best_params[
                "classifier__C"
            ],

        "penalty":
            best_params[
                "classifier__penalty"
            ],

        "class_weight":
            str(
                best_params[
                    "classifier__class_weight"
                ]
            )
    })


    # ============================================================
    # STORE OUTER PERFORMANCE
    # ============================================================

    outer_record = {

        "Outer_Repetition":
            outer_number,

        "Train_n":
            len(
                train_idx
            ),

        "Test_n":
            len(
                test_idx
            ),

        "Selected_K":
            selected_k,

        "Best_Inner_CV_AUC":
            best_inner_auc,

        "Features_after_Correlation":
            n_after_correlation,

        "Constant_Features_Removed":
            len(
                fitted_corr_filter
                .constant_features_
            ),

        "Correlated_Features_Removed":
            len(
                fitted_corr_filter
                .correlated_features_
            )
    }


    outer_record.update(
        test_metrics
    )


    outer_results.append(
        outer_record
    )


    # ============================================================
    # STORE HELD-OUT PATIENT PREDICTIONS
    # ============================================================

    for local_position, row_index in enumerate(
        test_idx
    ):

        test_prediction_records.append({

            "Outer_Repetition":
                outer_number,

            "Row_Index":
                int(
                    row_index
                ),

            "PatientID":
                patient_ids.iloc[
                    row_index
                ],

            "True_Label":
                int(
                    y.iloc[
                        row_index
                    ]
                ),

            "Test_Probability":
                float(
                    y_test_prob[
                        local_position
                    ]
                ),

            "Test_Prediction":
                int(
                    y_test_pred[
                        local_position
                    ]
                ),

            "Selected_K":
                selected_k
        })


    # ============================================================
    # PRINT RESULT
    # ============================================================

    print(
        "\nSelected feature count:",
        selected_k
    )


    print(
        "Best inner CV AUC:",
        round(
            best_inner_auc,
            3
        )
    )


    print(
        "Held-out test AUC:",
        round(
            test_metrics[
                "ROC_AUC"
            ],
            3
        )
    )


    print(
        "Chosen LR parameters:",
        best_params
    )


    # ============================================================
    # CHECKPOINTS
    # ============================================================

    pd.DataFrame(
        outer_results
    ).to_csv(

        os.path.join(
            OUTPUT_DIR,
            "checkpoint_outer_results.csv"
        ),

        index=False
    )


    pd.DataFrame(
        k_search_results
    ).to_csv(

        os.path.join(
            OUTPUT_DIR,
            "checkpoint_k_search.csv"
        ),

        index=False
    )


    pd.DataFrame(
        test_prediction_records
    ).to_csv(

        os.path.join(
            OUTPUT_DIR,
            "checkpoint_test_predictions.csv"
        ),

        index=False
    )


    pd.DataFrame(
        selected_feature_records
    ).to_csv(

        os.path.join(
            OUTPUT_DIR,
            "checkpoint_selected_features.csv"
        ),

        index=False
    )


    pd.DataFrame(
        chosen_parameter_records
    ).to_csv(

        os.path.join(
            OUTPUT_DIR,
            "checkpoint_LR_hyperparameters.csv"
        ),

        index=False
    )


    # ============================================================
    # CLEAR SPLIT CACHE
