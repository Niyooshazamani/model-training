# ================================================================
# 8. METRIC FUNCTION
# ================================================================

def calculate_metrics(
    y_true,
    probabilities,
    threshold=0.50
):

    y_true = np.asarray(
        y_true
    ).astype(int)


    probabilities = np.asarray(
        probabilities
    ).astype(float)


    predictions = (

        probabilities
        >=
        threshold

    ).astype(int)


    tn, fp, fn, tp = confusion_matrix(

        y_true,

        predictions,

        labels=[0, 1]

    ).ravel()


    sensitivity = recall_score(

        y_true,

        predictions,

        pos_label=1,

        zero_division=0
    )


    specificity = recall_score(

        y_true,

        predictions,

        pos_label=0,

        zero_division=0
    )


    precision = precision_score(

        y_true,

        predictions,

        zero_division=0
    )


    npv = (

        tn / (tn + fn)

        if (tn + fn) > 0

        else 0
    )


    gmean = np.sqrt(

        sensitivity
        *
        specificity
    )


    return {

        "ROC_AUC":
            roc_auc_score(
                y_true,
                probabilities
            ),

        "PR_AUC_AP":
            average_precision_score(
                y_true,
                probabilities
            ),

        "Accuracy":
            accuracy_score(
                y_true,
                predictions
            ),

        "Balanced_Accuracy":
            balanced_accuracy_score(
                y_true,
                predictions
            ),

        "Sensitivity":
            sensitivity,

        "Specificity":
            specificity,

        "Precision_PPV":
            precision,

        "NPV":
            npv,

        "F1":
            f1_score(
                y_true,
                predictions,
                zero_division=0
            ),

        "G_mean":
            gmean,

        "Brier_Score":
            brier_score_loss(
                y_true,
                probabilities
            ),

        "TN":
            tn,

        "FP":
            fp,

        "FN":
            fn,

        "TP":
            tp
    }


# ================================================================
# 9. REPEATED STRATIFIED HOLDOUT
# ================================================================

outer_splitter = StratifiedShuffleSplit(

    n_splits=
        N_OUTER_SPLITS,

    test_size=
        TEST_SIZE,

    random_state=
